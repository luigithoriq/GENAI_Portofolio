---
import { profile } from '../data/profile';

const links = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Education & Experience' },
  { href: '#research', label: 'Research' },
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="#about">{profile.nameEN}</a>

    <div class="controls">
      <button class="theme-toggle" type="button" aria-label="Switch to dark mode">
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
        </svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    </div>

    <nav id="site-nav" class="nav" aria-label="Sections">
      <ul>
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeBtn = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
  const menuBtn = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const nav = document.getElementById('site-nav')!;

  function syncThemeLabel() {
    const dark = root.dataset.theme === 'dark';
    themeBtn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
  }
  syncThemeLabel();

  themeBtn.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    syncThemeLabel();
  });

  function setMenu(open: boolean) {
    menuBtn.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('open', open);
  }

  menuBtn.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
  nav.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav.classList.contains('open')) {
      setMenu(false);
      menuBtn.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    min-height: var(--header-h);
    gap: 0 16px;
  }

  .brand {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--text);
    text-decoration: none;
    margin-right: auto;
  }

  .controls {
    display: flex;
    gap: 8px;
    order: 2;
  }

  button {
    font: inherit;
    font-size: 0.95rem;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 6px;
    min-height: 44px;
    min-width: 44px;
    padding: 0 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  button:hover {
    background: var(--surface);
  }

  :global([data-theme='dark']) .icon-moon,
  :global([data-theme='light']) .icon-sun {
    display: none;
  }

  .nav {
    display: none;
    width: 100%;
    order: 3;
  }

  .nav.open {
    display: block;
  }

  .nav ul {
    list-style: none;
    margin: 0;
    padding: 4px 0 12px;
  }

  .nav a {
    display: block;
    padding: 10px 0;
    color: var(--text);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--accent);
  }

  @media (min-width: 900px) {
    .menu-toggle {
      display: none;
    }

    .nav,
    .nav.open {
      display: block;
      width: auto;
      order: 1;
    }

    .nav ul {
      display: flex;
      gap: 22px;
      padding: 0;
    }

    .nav a {
      padding: 8px 0;
      font-size: 0.95rem;
    }
  }
</style>
