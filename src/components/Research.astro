---
import { research } from '../data/profile';
---

<section id="research" class="section" aria-labelledby="research-title">
  <h2 id="research-title" class="section-label">Research</h2>

  <article class="paper panel">
    <p class="meta">{research.period} · {research.lab}</p>
    <h3>{research.title}</h3>
    <p class="summary">{research.summary}</p>

    <h4>My role: {research.role}</h4>
    <ul class="work">
      {research.work.map((w) => <li>{w}</li>)}
    </ul>

    <ul class="tags" aria-label="Tools">
      {research.tools.map((t) => <li>{t}</li>)}
    </ul>

    {research.link && <p class="more"><a href={research.link} target="_blank" rel="noopener">Read more about this research</a></p>}
  </article>
</section>

<style>
  /* Research is the featured block: a larger, deeper raised panel. */
  .paper {
    box-shadow: 10px 10px 24px var(--shadow-dark), -10px -10px 24px var(--shadow-light);
    border-top: 4px solid var(--accent);
  }

  h3 {
    font-size: clamp(1.5rem, 4vw, 1.9rem);
    margin: 6px 0 14px;
  }

  .summary {
    font-size: 1.1rem;
    max-width: 58ch;
  }

  h4 {
    font-size: 0.95rem;
    color: var(--muted);
    margin: 22px 0 8px;
  }

  .work {
    margin: 0 0 22px;
    padding-left: 20px;
  }

  .work li + li {
    margin-top: 4px;
  }

  .more {
    margin: 20px 0 0;
  }

</style>
