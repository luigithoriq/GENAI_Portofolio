---
import { education, experience, extras } from '../data/profile';

const groups = [
  { heading: 'Education', items: education },
  { heading: 'Experience', items: experience },
];
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <h1 id="experience-title" class="section-label">Education &amp; Experience</h1>

  <div class="body">
    {
      groups.map((g) => (
        <div class="group panel">
          <h3 class="group-title">{g.heading}</h3>
          <ol class="timeline">
            {g.items.map((item) => (
              <li>
                <p class="period">{item.period}</p>
                <h4>{item.title}</h4>
                <p class="place">{item.place}</p>
                <p class="detail">{item.detail}</p>
              </li>
            ))}
          </ol>
        </div>
      ))
    }

    <div class="extras panel">
      <div>
        <h3 class="group-title">Certifications</h3>
        <ul>{extras.certifications.map((c) => <li>{c}</li>)}</ul>
      </div>
      <div>
        <h3 class="group-title">Languages</h3>
        <ul>{extras.languages.map((l) => <li>{l}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<style>
  .group + .group {
    margin-top: 28px;
  }

  .group-title {
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 26px;
    position: relative;
  }

  /* The timeline is a groove pressed into the panel, with raised dots along it. */
  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 6px;
    border-radius: 3px;
    box-shadow: var(--inset);
  }

  .timeline li {
    position: relative;
    padding-bottom: 28px;
  }

  .timeline li:last-child {
    padding-bottom: 0;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: -31px;
    top: 5px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: var(--raised-sm);
  }

  .timeline li:first-child::before {
    background: var(--leaf);
    box-shadow: var(--raised-sm), inset 0 0 0 4px var(--bg);
  }

  .period {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0 0 2px;
  }

  h4 {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0;
  }

  .place {
    margin: 0 0 6px;
    font-style: italic;
  }

  .detail {
    margin: 0;
    max-width: 62ch;
  }

  .extras {
    display: grid;
    gap: 24px;
    margin-top: 28px;
  }

  .extras ul {
    margin: 0;
    padding-left: 18px;
  }

  @media (min-width: 640px) {
    .extras {
      grid-template-columns: 1.4fr 1fr;
    }
  }
</style>
