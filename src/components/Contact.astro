---
import { contact } from '../data/profile';

const links = [
  { label: 'Email', href: contact.email && `mailto:${contact.email}`, text: contact.email },
  { label: 'LinkedIn', href: contact.linkedin, text: contact.linkedin.replace(/^https?:\/\/(www\.)?/, '') },
  { label: 'GitHub', href: contact.github, text: contact.github.replace(/^https?:\/\//, '') },
].filter((l) => l.href);
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <h1 id="contact-title" class="section-label">Contact</h1>

  <div>
    <p class="lead">I am happy to talk about research, course projects, or part-time work in AI and data. Email is the fastest way to reach me.</p>

    <!-- No backend: the form builds a pre-filled email and hands it to the visitor's mail app. -->
    <form class="mail-form panel" data-to={contact.email} novalidate>
      <div class="field">
        <label for="cf-name">Your name</label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="cf-subject">Subject</label>
        <input id="cf-subject" name="subject" type="text" placeholder="e.g. Research collaboration" required />
      </div>
      <div class="field">
        <label for="cf-message">Message</label>
        <textarea id="cf-message" name="message" rows="5" required></textarea>
      </div>
      <p class="status" role="status" aria-live="polite"></p>
      <div class="actions">
        <button type="submit">Write me an email</button>
        <span class="hint">Opens your email app with this message filled in.</span>
      </div>
    </form>

    <dl class="links panel">
      {
        links.map((l) => (
          <div>
            <dt>{l.label}</dt>
            <dd>
              <a href={l.href} {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                {l.text}
              </a>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('.mail-form');
    if (!form) return;
    const status = form.querySelector<HTMLElement>('.status')!;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')];
      const empty = fields.filter((f) => !f.value.trim());
      fields.forEach((f) => f.setAttribute('aria-invalid', String(empty.includes(f))));

      if (empty.length) {
        status.dataset.state = 'error';
        status.textContent = 'Please fill in every field before sending.';
        empty[0].focus();
        return;
      }

      const data = new FormData(form);
      const subject = String(data.get('subject')).trim();
      const body = `${String(data.get('message')).trim()}\n\n${String(data.get('name')).trim()}`;
      window.location.href = `mailto:${form.dataset.to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      status.dataset.state = 'ok';
      status.textContent = 'Your email app should open now. If nothing happens, use the email address below.';
    });
  });
</script>

<style>
  .lead {
    font-family: var(--serif);
    font-size: 1.25rem;
    max-width: 44ch;
    margin-bottom: 24px;
  }

  .mail-form {
    display: grid;
    gap: 16px;
    margin-bottom: 28px;
  }

  .field {
    display: grid;
    gap: 6px;
  }

  label {
    font-size: 0.95rem;
    font-weight: 600;
  }

  input,
  textarea {
    font: inherit;
    color: var(--text);
    background: var(--bg);
    border: 0;
    border-radius: 12px;
    box-shadow: var(--inset);
    padding: 12px 14px;
    width: 100%;
    resize: vertical;
  }

  input::placeholder {
    color: var(--muted);
  }

  [aria-invalid='true'] {
    outline: 2px solid var(--accent);
  }

  .status {
    margin: 0;
    min-height: 1.5em;
    font-size: 0.95rem;
  }

  .status[data-state='ok'] {
    color: var(--leaf);
  }

  .status[data-state='error'] {
    color: var(--accent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }

  button {
    font: inherit;
    font-weight: 600;
    color: var(--bg);
    background: var(--accent);
    border: 0;
    border-radius: 12px;
    min-height: 48px;
    padding: 0 22px;
    box-shadow: var(--raised-sm);
    cursor: pointer;
  }

  button:active {
    box-shadow: inset 3px 3px 7px rgb(0 0 0 / 0.25);
  }

  .hint {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .links {
    margin: 0;
  }

  .links div {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }

  .links div:last-child {
    border-bottom: 0;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
</style>
